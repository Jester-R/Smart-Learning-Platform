# Copy this file to .env and fill in real values. Never commit .env.
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
PORTAL_PLATFORM_COMMISSION_RATE=0.15
PORTAL_REQUIRE_EMAIL_VERIFICATION=False

# SMTP (used when DJANGO_ENV=production)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10

# Database engine: sqlite (local dev) or mysql (production/AWS)
DB_ENGINE=sqlite

# SQLite (used when DB_ENGINE=sqlite)
DB_SQLITE_NAME=db.sqlite3

# MySQL (used when DB_ENGINE=mysql)
DB_NAME=smart_learning
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Google Gemini (backend only; never expose to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest

# Certificate verification base URL used in generated PDFs
SITE_URL=http://127.0.0.1:8000
